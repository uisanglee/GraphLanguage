{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compact pseudocode AST GraphIR v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["graphir_version", "representation", "interface", "entry_function", "functions", "module_description", "class_descriptions", "notes"],
  "properties": {
    "graphir_version": {"const": "pseudocode-graphir-3"},
    "representation": {"const": "compact-pseudocode-ast-graph"},
    "interface": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "entrypoint", "signature"],
      "properties": {
        "mode": {"enum": ["function", "stdio"]},
        "entrypoint": {"type": "string"},
        "signature": {"type": "string"}
      }
    },
    "entry_function": {"type": "string"},
    "functions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/function"}},
    "module_description": {"type": "string"},
    "class_descriptions": {"type": "object", "additionalProperties": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "ports": {"type": "object", "additionalProperties": {"type": "string"}},
    "endpoint": {
      "type": "array", "prefixItems": [{"type": "string"}, {"type": "string"}],
      "minItems": 2, "maxItems": 2
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "from", "to"],
      "properties": {
        "kind": {"enum": ["data", "control", "state"]},
        "from": {"$ref": "#/$defs/endpoint"},
        "to": {"$ref": "#/$defs/endpoint"}
      }
    },
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["inputs", "outputs", "nodes", "edges", "falls_through"],
      "properties": {
        "inputs": {"$ref": "#/$defs/ports"},
        "outputs": {"$ref": "#/$defs/ports"},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
        "falls_through": {"type": "boolean"}
      }
    },
    "branch": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "when", "body"],
      "properties": {
        "label": {"enum": ["then", "else"]},
        "when": {"type": ["string", "null"]},
        "body": {"$ref": "#/$defs/body"}
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "inputs", "outputs", "config"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["Input", "Resource", "Assign", "Update", "Call", "Loop", "Branch", "Assert", "Return", "Control"]},
        "inputs": {"$ref": "#/$defs/ports"},
        "outputs": {"$ref": "#/$defs/ports"},
        "config": {"type": "object"},
        "body": {"$ref": "#/$defs/body"},
        "else_body": {"$ref": "#/$defs/body"},
        "branches": {"type": "array", "items": {"$ref": "#/$defs/branch"}}
      }
    },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "signature", "description", "body"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "signature": {"type": "string"},
        "description": {"type": "string"},
        "body": {"$ref": "#/$defs/body"}
      }
    }
  }
}
