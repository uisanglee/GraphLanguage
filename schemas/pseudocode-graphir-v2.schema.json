{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structural pseudocode GraphIR v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graphir_version",
    "interface",
    "entry_function",
    "functions",
    "module_description",
    "class_descriptions",
    "notes"
  ],
  "properties": {
    "graphir_version": {
      "const": "pseudocode-graphir-2"
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "entrypoint",
        "signature"
      ],
      "properties": {
        "mode": {
          "enum": [
            "function",
            "stdio"
          ]
        },
        "entrypoint": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      }
    },
    "entry_function": {
      "type": "string"
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/function"
      }
    },
    "module_description": {
      "type": "string"
    },
    "class_descriptions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "ports": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "endpoint": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/endpoint"
        },
        "to": {
          "$ref": "#/$defs/endpoint"
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "outputs",
        "nodes",
        "edges"
      ],
      "properties": {
        "inputs": {
          "$ref": "#/$defs/ports"
        },
        "outputs": {
          "$ref": "#/$defs/ports"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when",
        "body"
      ],
      "properties": {
        "when": {
          "type": [
            "string",
            "null"
          ]
        },
        "body": {
          "$ref": "#/$defs/body"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "description",
        "inputs",
        "outputs",
        "config"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "Input",
            "Output",
            "Literal",
            "Compute",
            "Call",
            "Loop",
            "Branch",
            "Resource",
            "Effect",
            "Assert"
          ]
        },
        "description": {
          "type": "string"
        },
        "inputs": {
          "$ref": "#/$defs/ports"
        },
        "outputs": {
          "$ref": "#/$defs/ports"
        },
        "config": {
          "type": "object"
        },
        "body": {
          "$ref": "#/$defs/body"
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branch"
          }
        }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "signature",
        "description",
        "pseudocode",
        "body"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "pseudocode": {
          "type": "string"
        },
        "body": {
          "$ref": "#/$defs/body"
        }
      }
    }
  }
}
