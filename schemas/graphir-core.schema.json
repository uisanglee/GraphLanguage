{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/graphir/core/0.2/schema.json",
  "title": "GraphIR Core 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["graphir_version", "interface", "nodes", "edges"],
  "properties": {
    "graphir_version": {"const": "0.2.0"},
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {"const": "python"},
        "python_version": {"type": "string"}
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "entrypoint", "signature"],
      "properties": {
        "mode": {"enum": ["function", "stdio", "repository_patch"]},
        "entrypoint": {"type": ["string", "null"]},
        "signature": {"type": ["string", "null"]},
        "repository": {"type": ["string", "null"]},
        "base_commit": {"type": ["string", "null"]}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "constraints": {"type": "array", "items": {"type": "string"}},
    "examples": {"type": "array", "items": {"$ref": "#/$defs/example"}},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_:/-]*$"
    },
    "ports": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "inputs", "outputs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {
          "enum": [
            "Input", "Output", "Literal", "Compute", "Call", "Loop", "Branch",
            "Resource", "Context", "Effect", "Assert", "Test", "SourceArtifact",
            "Locate", "Edit", "AddArtifact", "DeleteArtifact", "Patch"
          ]
        },
        "description": {"type": "string", "minLength": 1},
        "inputs": {"$ref": "#/$defs/ports"},
        "outputs": {"$ref": "#/$defs/ports"},
        "config": {"type": "object"},
        "control": {
          "type": "object", "additionalProperties": false,
          "required": ["for_each", "item", "state"],
          "properties": {
            "for_each": {"type": "string"}, "item": {"type": "string"},
            "state": {"type": "array", "items": {"type": "string"}}
          }
        },
        "body": {"$ref": "#/$defs/body"},
        "branches": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["when", "body"],
            "properties": {"when": {"type": ["string", "null"]}, "body": {"$ref": "#/$defs/body"}}
          }
        },
        "constraints": {"type": "array", "items": {"type": "string"}},
        "examples": {"type": "array", "items": {"$ref": "#/$defs/example"}},
        "metadata": {"type": "object"}
      }
    },
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["inputs", "outputs", "nodes", "edges"],
      "properties": {
        "inputs": {"$ref": "#/$defs/ports"}, "outputs": {"$ref": "#/$defs/ports"},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "pattern": "^(\\$input|[A-Za-z_][A-Za-z0-9_:/-]*)\\.[A-Za-z_][A-Za-z0-9_:/-]*$"},
        "to": {"type": "string", "pattern": "^(\\$output|[A-Za-z_][A-Za-z0-9_:/-]*)\\.[A-Za-z_][A-Za-z0-9_:/-]*$"}
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs"],
      "properties": {
        "inputs": {"type": "object"},
        "outputs": {"type": "object"},
        "description": {"type": "string"}
      }
    }
  }
}
