__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Local credentials and machine-specific configuration
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

